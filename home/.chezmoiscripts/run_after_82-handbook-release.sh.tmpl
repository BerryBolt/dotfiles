{{ if (get . "handbook_updater_checkout") -}}
#!/bin/bash
# Register the release check declared by the selected repository.
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
hermes-python {{ joinPath .handbook_updater_checkout "release.py" | quote }} register <<'PYTHON'
import runpy
import sys
script = sys.argv.pop(1)
runpy.run_path(script, run_name='__main__')
PYTHON
{{ end -}}
