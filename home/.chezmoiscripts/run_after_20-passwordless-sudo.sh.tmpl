#!/bin/bash
# Give the agent account passwordless sudo. The agent administers its own VM
# (VISION.md "Full guest authority"), and unattended package, service, and
# OS maintenance cannot answer a password prompt. The account password in the
# op_account_item item is read only when sudo still needs a password, to
# install the rule; it is piped to sudo and never stored or printed.

set -euo pipefail

export PATH="$HOME/.local/share/mise/shims:$PATH"

# Sorts after the installer's per-user rule (04_<user>), which it overrides,
# and before Omarchy's narrower rules, which keep their effect.
SUDOERS_FILE="/etc/sudoers.d/05-dotfiles-nopasswd"
OP_ITEM_REF="op://{{ .op_vault }}/{{ .op_account_item }}"
ACCOUNT="$(id -un)"
CONTENT="# Managed by dotfiles (run_after_20-passwordless-sudo.sh).
$ACCOUNT ALL=(ALL:ALL) NOPASSWD: ALL"

# Stage beside the target (sudoers skips names containing a dot), validate as
# root, then move into place so a bad rule never becomes active.
# shellcheck disable=SC2016  # expanded by the root shell
INSTALL_RULE='install -m 0440 -o root -g root "$1" "$2.new" &&
if visudo -cf "$2.new" >/dev/null; then mv -f "$2.new" "$2"; else rm -f "$2.new"; exit 1; fi'

load_op_token() {
    if [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
        return 0
    fi
    if [[ ! -f "$HOME/.config/op/env" ]]; then
        return 1
    fi
    set -a
    # shellcheck disable=SC1091
    source "$HOME/.config/op/env" || { set +a; return 1; }
    set +a
    [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]
}

# -k ignores a cached sudo timestamp, so only the sudoers rules decide.
sudo_without_password() {
    sudo -k -n true 2>/dev/null
}

rule_current() {
    [[ "$(sudo -n stat -c '%a %U:%G' "$SUDOERS_FILE" 2>/dev/null)" == "440 root:root" ]] &&
        [[ "$(sudo -n cat "$SUDOERS_FILE" 2>/dev/null)" == "$CONTENT" ]]
}

if sudo_without_password && rule_current; then
    echo "Passwordless sudo rule is current."
    exit 0
fi

staged="$(mktemp)"
trap 'rm -f "$staged"' EXIT
printf '%s\n' "$CONTENT" > "$staged"

if sudo_without_password; then
    sudo -n sh -c "$INSTALL_RULE" sh "$staged" "$SUDOERS_FILE"
else
    if ! load_op_token; then
        echo "Error: OP_SERVICE_ACCOUNT_TOKEN not set and ~/.config/op/env is missing or empty." >&2
        echo "       Re-run install.sh or invoke chezmoi via chezmoi-with-op." >&2
        exit 1
    fi
    if ! item_user=$(op read "$OP_ITEM_REF/username" 2>/dev/null); then
        echo "Error: failed to read the workstation account item from 1Password." >&2
        echo "       Expected: $OP_ITEM_REF (Server item with 'username' and 'password')" >&2
        exit 1
    fi
    if [[ "$item_user" != "$ACCOUNT" ]]; then
        echo "Error: $OP_ITEM_REF is the login for '$item_user', not '$ACCOUNT'." >&2
        exit 1
    fi
    if ! op read "$OP_ITEM_REF/password" | sudo -k -S -p '' sh -c "$INSTALL_RULE" sh "$staged" "$SUDOERS_FILE"; then
        echo "Error: could not install $SUDOERS_FILE. sudo rejected the password in $OP_ITEM_REF," >&2
        echo "       or the rule failed validation. Update the item if the account password changed." >&2
        exit 1
    fi
fi

if ! sudo_without_password; then
    echo "Error: installed $SUDOERS_FILE, but sudo still requires a password." >&2
    echo "       A sudoers rule that sorts after it overrides it; check /etc/sudoers.d." >&2
    exit 1
fi
echo "Installed passwordless sudo for $ACCOUNT ($SUDOERS_FILE)."
