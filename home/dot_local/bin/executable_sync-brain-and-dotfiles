#!/usr/bin/env python3
"""Observe publication problems, fast-forward clean checkouts, and apply setup."""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def run(*args):
    result = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, text=True, timeout=1800)
    if result.returncode:
        raise RuntimeError(args[0] + ' operation failed; inspect locally')
    return result.stdout.rstrip('\n')


def observe(repo, apply=False):
    issues = []
    counts = {}
    def issue(category, reason):
        issues.append({'category': category, 'reason': reason})
    def git(*args):
        return run('git', '-C', str(repo), *args)
    complete = False
    try:
        common = Path(git('rev-parse', '--path-format=absolute', '--git-common-dir'))
        with (common / 'publication.lock').open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                counts['publisher_active'] = True
                return issues, counts, False
            original = git('rev-parse', 'HEAD')
            branch = git('branch', '--show-current')
            counts['modified'] = len([s for s in git('diff', '--name-only', '-z', 'HEAD').split('\0') if s])
            counts['untracked'] = len([s for s in git('ls-files', '--others', '--exclude-standard', '-z').split('\0') if s])
            if counts['modified']:
                issue('publication', 'modified files')
            if counts['untracked']:
                issue('publication', 'untracked files')
            counts['stashes'] = len(git('stash', 'list', '--format=%H').splitlines())
            if counts['stashes']:
                issue('publication', 'stashes require ownership review')
            worktrees = [s[len('worktree '):] for s in git('worktree', 'list', '--porcelain', '-z').split('\0') if s.startswith('worktree ')]
            secondary = [Path(p) for p in worktrees if Path(p).resolve() != repo.resolve()]
            counts['secondary_worktrees'] = len(secondary)
            counts['secondary_dirty'] = 0
            counts['secondary_detached'] = 0
            counts['secondary_unavailable'] = 0
            for path in secondary:
                try:
                    dirty = run('git', '-C', str(path), 'status', '--porcelain', '--untracked-files=all')
                    detached = not run('git', '-C', str(path), 'branch', '--show-current')
                except (RuntimeError, OSError, subprocess.TimeoutExpired):
                    counts['secondary_unavailable'] += 1
                    continue
                if dirty:
                    counts['secondary_dirty'] += 1
                if detached:
                    counts['secondary_detached'] += 1
            if counts['secondary_dirty'] or counts['secondary_detached']:
                issue('publication', 'secondary worktrees require ownership review')
            if counts['secondary_unavailable']:
                issue('publication', 'secondary worktrees unavailable; inspect their registrations locally')
            # Fetch before deciding whether local edits permit integration.
            refs = git('for-each-ref', '--format=%(refname)%09%(upstream)%09%(upstream:remotename)%09%(upstream:remoteref)', 'refs/heads/').splitlines()
            remotes = {line.split('\t')[2] for line in refs if len(line.split('\t')) >= 3}
            remotes -= {'', '.'}
            failed_remotes = set()
            for remote_name in sorted(remotes):
                try:
                    git('fetch', '--quiet', '--prune', remote_name)
                except (RuntimeError, OSError, subprocess.TimeoutExpired):
                    failed_remotes.add(remote_name)
            counts['failed_remote_fetches'] = len(failed_remotes)
            if failed_remotes:
                issue('observation', 'tracked remote fetch failed; inspect branch upstreams and access locally')
            counts.update(branches_without_upstream=0, branches_ahead=0, branches_diverged=0, unpushed_commits=0)
            remote, destination, ahead, behind = None, None, None, None
            for line in refs:
                fields = line.split('\t')
                fields += [''] * (4 - len(fields))
                ref, upstream = fields[:2]
                local_ahead = local_behind = None
                if not upstream:
                    counts['branches_without_upstream'] += 1
                else:
                    try:
                        local_ahead, local_behind = map(int, git('rev-list', '--left-right', '--count', ref + '...' + upstream).split())
                    except RuntimeError:
                        counts['branches_without_upstream'] += 1
                    else:
                        counts['branches_ahead'] += int(local_ahead > 0)
                        counts['branches_diverged'] += int(local_ahead > 0 and local_behind > 0)
                        counts['unpushed_commits'] += local_ahead
                if ref == 'refs/heads/' + branch:
                    remote, destination = fields[2:4]
                    ahead, behind = local_ahead, local_behind
            if counts['branches_without_upstream']:
                issue('publication', 'local branches lack a usable upstream')
            if counts['unpushed_commits']:
                issue('publication', 'unpushed commits')
            if counts['branches_diverged']:
                issue('publication', 'diverged branches')
            if not branch:
                issue('publication', 'checkout detached')
            elif not remote or remote == '.' or ahead is None:
                issue('publication', 'checkout lacks a remote upstream')
            setup_branch_allowed = not apply
            if remote in failed_remotes:
                issue('observation', 'checkout upstream fetch failed; integration and setup apply deferred')
            elif apply and branch and remote and remote != '.':
                default_lines = git('ls-remote', '--symref', remote, 'HEAD').splitlines()
                defaults = [line.split()[1] for line in default_lines if line.startswith('ref: ')]
                if len(defaults) != 1:
                    issue('publication', 'remote default branch is ambiguous')
                elif 'refs/heads/' + branch != defaults[0] or destination != defaults[0]:
                    issue('publication', 'setup apply requires the remote default branch')
                else:
                    setup_branch_allowed = True
            complete = not failed_remotes
            # Never integrate a dirty, detached, ahead, or non-default setup checkout.
            blocked = bool(counts['modified'] or counts['untracked'] or not branch
                           or not remote or remote == '.' or remote in failed_remotes
                           or ahead is None or ahead or not setup_branch_allowed)
            if not blocked:
                if git('rev-parse', 'HEAD') != original or git('branch', '--show-current') != branch or git('status', '--porcelain', '--untracked-files=all'):
                    raise RuntimeError('checkout changed during observation')
                if behind:
                    git('-c', 'merge.autostash=false', 'merge', '--ff-only', '--quiet', '@{upstream}')
                sha = git('rev-parse', 'HEAD')
                if apply:
                    marker = state / 'applied-sha'
                    if not marker.exists() or marker.read_text().strip() != sha:
                        attempt = state / 'apply-attempt'
                        retry = False
                        if scheduled and attempt.exists():
                            last_sha, last_time = attempt.read_text().split()
                            retry = last_sha == sha and time.time() - float(last_time) < 3600
                        if retry:
                            issue('apply', 'apply incomplete; retry deferred for up to one hour')
                        else:
                            save(attempt, sha + ' ' + str(time.time()) + '\n')
                            try:
                                run('chezmoi-with-op', '--no-tty', '--force=false', 'apply')
                                if git('rev-parse', 'HEAD') != sha or git('status', '--porcelain', '--untracked-files=all'):
                                    raise RuntimeError('source changed during apply')
                            except RuntimeError:
                                issue('apply', 'apply failed; inspect locally with scoped credentials')
                            else:
                                save(marker, sha + '\n')
    except Exception:
        issue('observation', 'observation incomplete; inspect checkout and remote access locally')
        complete = False
    return issues, counts, complete


def save(path, value):
    pending = path.with_suffix('.tmp')
    pending.write_text(value)
    pending.replace(path)


def should_wake(name, issues, complete):
    notice = state / (name + '-incidents.json')
    previous = json.loads(notice.read_text()) if notice.exists() else {}
    now = time.time()
    wake = False
    for category in ('publication', 'apply', 'observation'):
        active = any(i['category'] == category for i in issues)
        record = previous.get(category, {'observations': 0, 'last_wake': 0})
        if active:
            record['observations'] = record['observations'] + 1 if complete else 0
            ready = category != 'publication' or record['observations'] >= 2
            if ready and now - record['last_wake'] >= 3600:
                wake = True
                record['last_wake'] = now
            previous[category] = record
        elif complete:
            # An incomplete or failed fetch must never clear a publication incident.
            # Retain the cooldown when a cleared problem returns within the hour.
            if category in previous:
                record['observations'] = 0
        elif category in previous:
            record['observations'] = 0
    save(notice, json.dumps(previous))
    return wake


def main():
    global state, scheduled
    if sys.argv[1:] not in ([], ['--scheduled']):
        print('usage: sync-brain-and-dotfiles [--scheduled]', file=sys.stderr)
        return 2
    scheduled = bool(sys.argv[1:])
    os.environ['PATH'] = str(Path.home() / '.local/bin') + ':' + str(Path.home() / '.local/share/mise/shims') + ':' + os.environ.get('PATH', '/usr/bin:/bin')
    os.environ['GIT_TERMINAL_PROMPT'] = '0'
    os.environ['GIT_SSH_COMMAND'] = 'ssh -o BatchMode=yes -o ConnectTimeout=20'
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'sync-brain-and-dotfiles'
    state.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (state / 'run.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(json.dumps({'wakeAgent': False, 'status': 'sync already active'}))
            return 0 if scheduled else 1
        issues, diagnostics, wake = [], {}, False
        for name in ('brain', 'dotfiles'):
            try:
                source = Path.home() / 'brain' if name == 'brain' else Path(run('chezmoi', 'source-path'))
                repo = Path(run('git', '-C', str(source), 'rev-parse', '--show-toplevel'))
                found, counts, complete = observe(repo, apply=name == 'dotfiles')
            except Exception:
                found, counts, complete = [{'category': 'observation', 'reason': 'checkout unavailable; inspect locally'}], {}, False
            issues.extend(dict(item, repo=name) for item in found)
            diagnostics[name] = dict(counts, complete=complete)
            if scheduled:
                wake = should_wake(name, found, complete) or wake
        print(json.dumps({'wakeAgent': wake if scheduled else False, 'issues': issues, 'diagnostics': diagnostics}))
        incomplete = any(not counts['complete'] for counts in diagnostics.values())
        return 0 if scheduled else int(bool(issues) or incomplete)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception:
        print(json.dumps({'wakeAgent': True, 'issues': [{'repo': 'sync', 'category': 'observation', 'reason': 'unexpected setup failure; inspect locally'}]}))
        sys.exit(0 if sys.argv[1:] == ['--scheduled'] else 1)
