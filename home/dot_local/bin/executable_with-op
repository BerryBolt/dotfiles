#!/bin/bash
# Run one command with the 1Password service-account env loaded, without
# exporting it to the calling shell.
#
#   with-op op whoami
#   with-op item get <item>  # Hermes' browser vault, scoped to the vault
#   with-op bash -c 'op read "op://$OP_VAULT/<item>/<field>"'

set -eu

# Prepend known install locations so stripped-PATH callers (git hooks,
# IDE task runners, cron) can still resolve op and other mise tools.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

ENV_FILE="$HOME/.config/op/env"

if [ "$#" -eq 0 ]; then
    echo "usage: with-op <command> [args...]" >&2
    exit 2
fi

if [ ! -f "$ENV_FILE" ]; then
    echo "error: $ENV_FILE not found. Restore it by supplying the token to chezmoi-with-op:" >&2
    echo "         read -rsp 'Token: ' t && OP_SERVICE_ACCOUNT_TOKEN=\$t chezmoi-with-op apply --force ~/.config/op/env; unset t" >&2
    exit 1
fi

set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

# Hermes runs its configured op binary with item subcommands and no leading
# `op`. It only reads through this form, so nothing else is allowed here.
if [ "$1" = item ]; then
    case "${2:-}" in
        list|get) ;;
        *) echo "error: direct item mode supports only list and get." >&2; exit 2 ;;
    esac
    : "${OP_VAULT:?the credential env file must set OP_VAULT}"
    # Hermes parses plain text from password and one-time-code reads, and
    # passes --format json itself for lists.
    unset OP_FORMAT
    # A service account must name a vault; op ignores OP_VAULT for items.
    for arg in "$@"; do
        case "$arg" in
            --vault|--vault=*) exec op "$@" ;;
        esac
    done
    exec op "$@" --vault "$OP_VAULT"
fi

exec "$@"
