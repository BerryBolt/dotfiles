#!/usr/bin/env python3
"""Restore the workstation's declared Syncthing identity and configuration."""
import json
import os
from pathlib import Path
import subprocess
import xml.etree.ElementTree as ET

os.umask(0o077)
home = Path.home()
state = home / '.local/state/syncthing/workstation'
data = json.loads(subprocess.check_output(['chezmoi', 'data'], text=True))
vault = data['op_vault']

def op(*args):
    return subprocess.check_output(['with-op', 'op', *args, '--vault', vault], stderr=subprocess.PIPE)

def main():
    recovery = json.loads(op('document', 'get', 'Syncthing - Credential File'))
    if recovery.get('version') != 1:
        raise ValueError('unsupported recovery document version')
    api = json.loads(op('item', 'get', 'Syncthing - API key', '--format', 'json'))
    if api['category'] != 'API_CREDENTIAL':
        raise ValueError('Syncthing API key must be an API Credential item')
    key = next(f['value'] for f in api['fields'] if f['id'] == 'credential')
    config = ET.fromstring(recovery['config.xml'].replace('${HOME}', str(home)))
    config.find('gui/apikey').text = key
    files = {'cert.pem': recovery['cert.pem'], 'key.pem': recovery['key.pem'],
             'config.xml': ET.tostring(config, encoding='unicode') + '\n'}
    # Never replace an established device identity during reapply.
    for name in ('cert.pem', 'key.pem'):
        path = state / name
        if path.exists() and path.read_text() != files[name]:
            raise ValueError('existing Syncthing identity differs from the recovery document')
    changed = []
    for name, value in files.items():
        path = state / name
        current = path.read_text() if path.exists() else None
        same = current == value
        if name == 'config.xml' and current is not None:
            same = ET.canonicalize(current, strip_text=True) == ET.canonicalize(value, strip_text=True)
        if not same:
            changed.append(name)
    # Validate paths before stopping or changing the service.
    folders = [Path(f.attrib['path']) for f in config.findall('folder')]
    for folder in folders:
        if not folder.is_relative_to(home) or folder == home:
            raise ValueError('Syncthing folder must be inside the account home')
    subprocess.run(['systemctl', '--user', 'daemon-reload'], check=True)
    if changed:
        subprocess.run(['systemctl', '--user', 'stop', 'syncthing-workstation.service'], check=True)
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    state.chmod(0o700)
    for folder in folders:
        folder.mkdir(parents=True, exist_ok=True, mode=0o700)
        (folder / '.stfolder').mkdir(exist_ok=True)
    for name in changed:
        path = state / name
        temporary = path.with_suffix(path.suffix + '.restore')
        temporary.write_text(files[name])
        temporary.chmod(0o600)
        temporary.replace(path)
    for name in files:
        (state / name).chmod(0o600)
    subprocess.run(['systemctl', '--user', 'daemon-reload'], check=True)
    subprocess.run(['systemctl', '--user', 'enable', '--now', 'syncthing-workstation.service'], check=True)
    print('Syncthing workstation restored.' if changed else 'Syncthing workstation configuration unchanged.')

if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, StopIteration, ET.ParseError, subprocess.CalledProcessError):
        raise SystemExit('Syncthing restore failed. Check recovery item structure, vault access and the user service. Secret output was suppressed.')
