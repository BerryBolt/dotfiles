#!/usr/bin/env python3
"""Publish reviewed whole files and commits without consuming shared staging."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import stat
import subprocess
import sys


class Blocked(RuntimeError):
    pass


def git(repo, *args, ok=(0,), binary=False):
    result = subprocess.run(['git', '-C', str(repo), '--literal-pathspecs', *args],
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, timeout=1800)
    if result.returncode not in ok:
        raise Blocked('git ' + args[0] + ' failed; inspect locally, keep unpublished work')
    return result.stdout if binary else result.stdout.decode().strip()


def content(repo, name):
    path = repo / name
    # Do not follow a parent symlink outside the reviewed checkout.
    if any((repo / parent).is_symlink() for parent in PurePosixPath(name).parents):
        raise Blocked('selected path has a symlink parent')
    if not path.exists() and not path.is_symlink():
        return None
    mode = path.lstat().st_mode
    if stat.S_ISLNK(mode):
        data, kind = os.fsencode(os.readlink(path)), '120000'
    elif stat.S_ISREG(mode):
        data = path.read_bytes()
        kind = '100755' if mode & 0o111 else '100644'
    else:
        raise Blocked('selected path is not a regular file or symlink')
    return {'sha256': hashlib.sha256(data).hexdigest(), 'mode': kind}


def check_review(repo, review):
    if git(repo, 'symbolic-ref', '--quiet', '--short', 'HEAD') != review['branch']:
        raise Blocked('branch changed since review')
    if git(repo, 'rev-parse', 'HEAD') != review['head']:
        raise Blocked('HEAD changed since review; review again')
    if git(repo, 'diff', '--cached', '--name-only') or git(repo, 'ls-files', '--unmerged'):
        raise Blocked('another session has staged or conflicted work')
    for name, expected in review['paths'].items():
        if content(repo, name) != expected:
            raise Blocked('selected file differs from reviewed whole-file content')
        ignored = subprocess.run(['git', '-C', str(repo), 'check-ignore', '--quiet', '--', name],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if ignored.returncode == 0:
            raise Blocked('selected output is ignored; correct its placement')
        if ignored.returncode != 1:
            raise Blocked('could not check selected output ignore rules')


def fetch(repo, remote, destination):
    git(repo, 'fetch', '--quiet', '--no-tags', remote, 'refs/heads/' + destination)
    return git(repo, 'rev-parse', 'FETCH_HEAD')


def ancestor(repo, older, newer):
    result = subprocess.run(['git', '-C', str(repo), 'merge-base', '--is-ancestor', older, newer],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if result.returncode not in (0, 1):
        raise Blocked('could not verify ancestry')
    return result.returncode == 0


def validate_manifest(review):
    required = {'branch', 'head', 'remote', 'destination', 'paths', 'commits'}
    if set(review) != required or not isinstance(review['paths'], dict) or not isinstance(review['commits'], list):
        raise Blocked('invalid manifest fields; read runbooks/publication.md')
    for name in ('branch', 'remote', 'destination', 'head'):
        if not isinstance(review[name], str) or not review[name] or review[name].startswith('-'):
            raise Blocked('invalid manifest destination or checkout')
    for sha in [review['head'], *review['commits']]:
        if not isinstance(sha, str) or len(sha) != 40 or any(c not in '0123456789abcdef' for c in sha):
            raise Blocked('manifest needs full commit SHAs')
    for name, expected in review['paths'].items():
        path = PurePosixPath(name)
        if (not name or path.is_absolute() or '..' in path.parts or '.git' in path.parts
                or str(path) != name or '\x00' in name):
            raise Blocked('selected paths must be literal repository-relative files')
        if expected is not None and (not isinstance(expected, dict) or set(expected) != {'sha256', 'mode'}
                or expected['mode'] not in ('100644', '100755', '120000')
                or not isinstance(expected['sha256'], str) or len(expected['sha256']) != 64
                or any(c not in '0123456789abcdef' for c in expected['sha256'])):
            raise Blocked('invalid reviewed file hash or mode')


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog='Manifest format and review procedure: dotfiles runbooks/publication.md')
    parser.add_argument('--repo', required=True)
    parser.add_argument('--review', required=True, help='reviewed JSON manifest outside Git')
    parser.add_argument('--message', help='required when committing selected files')
    args = parser.parse_args()
    if os.environ.get('GIT_INDEX_FILE') or os.environ.get('GIT_DIR') or os.environ.get('GIT_WORK_TREE'):
        raise Blocked('custom Git index or checkout environment is unsupported')
    review = json.loads(Path(args.review).read_text())
    validate_manifest(review)
    repo = Path(git(args.repo, 'rev-parse', '--show-toplevel')).resolve()
    common = Path(git(repo, 'rev-parse', '--path-format=absolute', '--git-common-dir'))
    # Git metadata is outside the tracked tree and shared by all worktrees.
    with (common / 'publication.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Blocked('another publisher holds this repository lock')
        check_review(repo, review)
        branch, remote, destination = (review[k] for k in ('branch', 'remote', 'destination'))
        git(repo, 'check-ref-format', 'refs/heads/' + destination)
        if remote not in git(repo, 'remote').splitlines():
            raise Blocked('destination must use a configured remote')
        if (git(repo, 'config', '--get', 'branch.' + branch + '.remote') != remote
                or git(repo, 'config', '--get', 'branch.' + branch + '.merge') != 'refs/heads/' + destination):
            raise Blocked('upstream differs from reviewed destination or is missing')
        push_urls = git(repo, 'remote', 'get-url', '--push', '--all', remote).splitlines()
        fetch_urls = git(repo, 'remote', 'get-url', '--all', remote).splitlines()
        if len(push_urls) != 1 or push_urls != fetch_urls:
            raise Blocked('fetch and push must use one identical reviewed remote URL')
        url = push_urls[0]
        if not (url.startswith('git@') or url.startswith('ssh://')):
            raise Blocked('publication requires the configured SSH protocol; do not switch credentials')
        original = review['head']
        target = fetch(repo, remote, destination)
        check_review(repo, review)
        if not ancestor(repo, target, original):
            if ancestor(repo, original, target) and not git(repo, 'status', '--porcelain', '--untracked-files=all'):
                git(repo, '-c', 'merge.autostash=false', 'merge', '--ff-only', '--quiet', target)
                raise Blocked('checkout fast-forwarded; review and validate again before publication')
            raise Blocked('remote advanced; integrate only in a clean checkout, then review and validate again')
        pending = git(repo, 'rev-list', '--reverse', target + '..' + original).splitlines()
        if pending != review['commits']:
            raise Blocked('unpublished commit set differs from reviewed commits')
        for sha in pending:
            git(repo, 'verify-commit', sha)
        selected = list(review['paths'])
        if selected:
            if not args.message:
                raise Blocked('a commit message is required for selected files')
            check_review(repo, review)
            # Register new files for commit --only, without staging their content.
            additions = [p for p in selected if review['paths'][p] is not None
                         and not git(repo, 'ls-files', '--', p)]
            if additions:
                git(repo, 'add', '--intent-to-add', '--', *additions)
            check_review(repo, review)
            git(repo, 'commit', '-S', '--only', '-m', args.message, '--', *selected)
            commit = git(repo, 'rev-parse', 'HEAD')
            if git(repo, 'rev-list', '--parents', '-n', '1', commit).split() != [commit, original]:
                raise Blocked('commit parent changed; retained unpublished commit requires review')
            delta = set(git(repo, 'diff-tree', '--no-commit-id', '--name-only', '-r', '-z', commit, binary=True).decode().strip('\x00').split('\x00'))
            intended = set()
            for name, expected in review['paths'].items():
                entry = git(repo, 'ls-tree', '-z', commit, '--', name, binary=True)
                if expected is None:
                    if entry:
                        raise Blocked('committed deletion differs from review; do not push')
                else:
                    if not entry:
                        raise Blocked('committed file missing; do not push')
                    metadata = entry.split(b'\t', 1)[0].decode().split()
                    data = git(repo, 'cat-file', 'blob', metadata[2], binary=True)
                    if {'mode': metadata[0], 'sha256': hashlib.sha256(data).hexdigest()} != expected:
                        raise Blocked('committed content differs from review; do not push')
                if git(repo, 'diff-tree', '--no-commit-id', '--name-only', '-r', commit, '--', name):
                    intended.add(name)
            if delta != intended:
                raise Blocked('committed delta includes unreviewed paths; do not push')
            git(repo, 'verify-commit', commit)
        else:
            commit = original
        if git(repo, 'rev-parse', 'HEAD') != commit or git(repo, 'symbolic-ref', '--quiet', '--short', 'HEAD') != branch:
            raise Blocked('checkout moved before push; review retained commits')
        # Push the verified immutable commit, never a moving HEAD or a force refspec.
        try:
            git(repo, 'push', '--porcelain', remote, commit + ':refs/heads/' + destination)
        except Blocked:
            advanced = fetch(repo, remote, destination)
            if not ancestor(repo, commit, advanced):
                raise Blocked('push failed; fresh remote read retained, review and validate before retry or signed integration')
        proof = fetch(repo, remote, destination)
        if not ancestor(repo, commit, proof):
            raise Blocked('fresh remote destination does not contain the commit')
        print(json.dumps({'repository': str(repo), 'branch': branch, 'commit': commit,
                          'remote': remote, 'destination': destination, 'remote_commit': proof,
                          'proof': 'ancestor', 'landing': 'verify PR merge separately when applicable'}))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (Blocked, OSError, ValueError, TypeError, subprocess.SubprocessError) as error:
        # Do not expose command output or credential-bearing exception text.
        reason = str(error) if isinstance(error, Blocked) else 'invalid input or command failure; inspect locally'
        print('publish-reviewed: blocked: ' + reason, file=sys.stderr)
        sys.exit(1)
