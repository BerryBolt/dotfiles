{{- $agent_name := or (env "CHEZMOI_AGENT_NAME") (promptStringOnce . "agent_name" "Agent name (e.g., Berry Bolt)") -}}
{{- $agent_email := or (env "CHEZMOI_AGENT_EMAIL") (promptStringOnce . "agent_email" "Agent email") -}}
{{- $agent_handle_github := or (env "CHEZMOI_AGENT_HANDLE_GITHUB") (promptStringOnce . "agent_handle_github" "GitHub handle (e.g., BerryBolt)") -}}
{{- $op_vault := or (env "CHEZMOI_OP_VAULT") (promptStringOnce . "op_vault" "1Password vault name") -}}
{{- /* Token is read from env by private_env.tmpl, never persisted in [data]. */ -}}
{{- if eq (env "OP_SERVICE_ACCOUNT_TOKEN") "" -}}
{{- fail "OP_SERVICE_ACCOUNT_TOKEN must be set in env. Bootstrap via install.sh — it is the only supported entry point." -}}
{{- end -}}

[data]
  agent_name = {{ $agent_name | quote }}
  agent_email = {{ $agent_email | quote }}
  agent_handle_github = {{ $agent_handle_github | quote }}
  op_vault = {{ $op_vault | quote }}

[onepassword]
  mode = "service"
