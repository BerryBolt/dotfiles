[Unit]
Description=Syncthing workstation instance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/syncthing serve --no-browser --no-restart --home=%h/.local/state/syncthing/workstation
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/syncthing/workstation %h/.local/state/syncthing/workstation-files

[Install]
WantedBy=default.target
