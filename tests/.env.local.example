# Non-secret installer inputs for testing on the target Omarchy VM.
# Copy to tests/.env.local (ignored) and replace the placeholders with the
# account and vault under test. Supply OP_SERVICE_ACCOUNT_TOKEN separately
# (e.g. from the ignored repo-root .env) over a non-logged channel; never
# put the token in this file, a command argument, or Git.
CHEZMOI_AGENT_NAME="Example Agent"
CHEZMOI_AGENT_EMAIL=agent@example.com
CHEZMOI_AGENT_HANDLE_GITHUB=example-agent
CHEZMOI_OP_VAULT="<agent-vault>"
